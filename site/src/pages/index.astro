---
import BottomCTA from '@/components/BottomCTA.astro'
import CodeTabs from '@/components/CodeTabs.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import MagneticFieldTitle from '@/components/MagneticFieldTitle.astro'
import RaceTerminal from '@/components/RaceTerminal.astro'
import race from '@/data/race.json'
import saved from '@/data/receipt.json'
import Layout from '@/layouts/Layout.astro'
import { atTag } from '@/lib/links'
import { INIT } from '@/lib/start'

const TS = `import { solenoid } from '@solenoid.systems/sdk'

const sol = solenoid() // reads SOLENOID_KEY from the environment

export async function refund(order: string, amount: number) {
  await sol.spend(\`support-bot/\${order}\`, { refunds: 1 }) // throws LimitExceeded at the limit
  await payments.refund(order, amount)
}`
const CLI = `npx @solenoid.systems/cli limit support-bot refunds=1 --per child
npx @solenoid.systems/cli spend support-bot/o-1042 refunds=1`
const VERIFY = `import { verifyChain, type Receipt } from '@solenoid.systems/sdk'
import saved from './receipt.json' with { type: 'json' } // the receipt above
import wellKnown from './solenoid.json' with { type: 'json' } // saved once from https://api.solenoid.systems/.well-known/solenoid.json

const receipt = saved as Receipt
const { keys } = wellKnown
await verifyChain([receipt], keys) // true, with no network call`
const h2 = 'font-sans font-bold text-2xl md:text-3xl'
const h3 = 'font-sans font-bold text-xl'
const body = 'mt-4 text-zinc-400 max-w-2xl'
const note = 'mt-4 font-mono text-xs text-zinc-500'
---
<Layout title="Solenoid: limits on your AI agent's refunds, emails and deletes" description="Solenoid limits what your AI agent's tools do. Each tool calls spend before it acts, and past the limit spend throws, so the action never runs. Every recorded spend gets a signed receipt.">
  <Header pathname="/" />
  <main class="relative z-10">
    <section id="hero" class="min-h-screen flex flex-col items-center justify-center px-6 pt-24 pb-16">
      <MagneticFieldTitle text="SOLENOID.SYSTEMS" />
      <h1 class="font-sans font-black text-3xl md:text-5xl text-center max-w-3xl leading-tight">One retry, and your agent refunds the same order twice.</h1>
      <p class="mt-6 text-lg text-zinc-400 text-center max-w-2xl">Solenoid counts refunds per order, outside the agent. Allow one per order, and the second refund is refused before it runs. It only stops tools that ask Solenoid first.</p>
      <div id="start-hero" class="mt-10 w-full max-w-2xl">
        <div class="flex items-stretch border border-[#333] bg-[#0a0a0b]">
          <pre class="start-command flex-1 px-4 py-3 font-mono text-sm overflow-x-auto"><code>{INIT}</code></pre>
          <button type="button" data-copy={INIT} class="px-3 font-mono text-[11px] uppercase tracking-wider text-zinc-500 hover:text-accent border-l border-[#333]">Copy</button>
        </div>
        <p class="mt-2 text-sm text-zinc-500">Run it in your project's root. No email, no card: it creates your account, writes your bot's key to <code>.env</code> and saves your admin key for the CLI.</p>
        <a href="#start" class="mt-6 inline-block font-mono text-xs uppercase tracking-wider text-accent hover:underline">Next: the prompt that has your coding assistant add it</a>
      </div>
    </section>

    <div class="bg-[#050505]">
      <section id="race" class="px-6 py-20 max-w-4xl mx-auto">
        <h2 class={h2}>{race.calls} spends hit a limit of {race.limit} at once. Exactly {race.recorded} got through.</h2>
        <p class={body}>A recorded run of Solenoid's API code, one client per spend.</p>
        <div class="mt-8"><RaceTerminal race={race} /></div>
        <p class={note}>Test: <a class="underline hover:text-accent" href={atTag('e2e/test/concurrency.test.ts')}>e2e/test/concurrency.test.ts</a>. Recorder: <a class="underline hover:text-accent" href={atTag('e2e/record-race.ts')}>e2e/record-race.ts</a>.</p>
      </section>

      <section id="one-call" class="px-6 py-20 max-w-4xl mx-auto">
        <h2 class={h2}>One call, in front of the action</h2>
        <p class={body}>At the limit, <code>spend</code> throws and the refund never runs. It only limits tools that call it first.</p>
        <CodeTabs name="one-call" tabs={[{ label: 'TypeScript', lang: 'ts', code: TS }, { label: 'CLI', lang: 'sh', code: CLI }]} />
      </section>

      <section id="receipt" class="px-6 py-20 max-w-4xl mx-auto">
        <h2 class={h2}>A signed receipt for every recorded spend</h2>
        <p class={body}>This one came from the production API. Anyone with the public keys can check it offline.</p>
        <CodeTabs name="receipt" tabs={[{ label: 'Receipt', lang: 'json', code: JSON.stringify(saved.receipt, null, 2) }, { label: 'Verify', lang: 'ts', code: VERIFY }]} />
        <p class={note}><a class="underline hover:text-accent" href="/docs#receipts">Checking receipts offline, in the docs</a>.</p>
      </section>

      <div class="px-6 py-20 max-w-4xl mx-auto grid gap-12 md:grid-cols-2">
        <section id="limits">
          <h2 class={h3}>Any action your code can count</h2>
          <p class="mt-3 text-zinc-400">Emails work the same way: <code>emails=3 --per child</code> gives each customer three. To cap model costs, keep your gateway for that.</p>
          <p class={note}><a class="underline hover:text-accent" href="/docs#at-most-once">Per-order limits, in the docs</a>. Test: <a class="underline hover:text-accent" href={atTag('e2e/test/concurrency.test.ts')}>e2e/test/concurrency.test.ts</a>.</p>
        </section>
        <section id="outage">
          <h2 class={h3}>When Solenoid is down, refunds stop</h2>
          <p class="mt-3 text-zinc-400">Every limit fails closed by default. A limit set to <code>--on-outage open</code> lets actions through, unrecorded.</p>
          <p class={note}><a class="underline hover:text-accent" href="/docs#setting-limits">Outage settings, in the docs</a>.</p>
        </section>
      </div>

      <section id="pricing-strip" class="px-6 py-12 max-w-4xl mx-auto border-y border-[#222] flex flex-wrap items-baseline justify-between gap-4">
        <p class="text-zinc-300">Free for 100,000 spends a month, then spends are refused until the month turns. Pro is $29 USD a month for 2M spends.</p>
        <a href="/pricing" class="font-mono text-xs uppercase tracking-wider text-accent hover:underline">See pricing</a>
      </section>

      <section id="why" class="px-6 py-20 max-w-4xl mx-auto">
        <h2 class={h2}>A limit the agent can't talk past has to live outside it</h2>
        <p class={body}>An agent can keep acting after its owner says stop. I built Solenoid to be that limit. The agent's spend key can't change a limit. Keep the admin key, which can, out of your support bot's environment.</p>
        <p class={note}><a class="underline hover:text-accent" href="/docs#quickstart">The two keys, in the docs</a>.</p>
        <a href="/why" class="mt-3 inline-block font-mono text-xs uppercase tracking-wider text-accent hover:underline">My note on the /why page</a>
      </section>
    </div>

    <BottomCTA />
  </main>
  <Footer />
</Layout>
